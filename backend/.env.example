# AI Provider Configuration
# Set to 'ollama' for local Ollama or 'openrouter' for OpenRouter
AI_PROVIDER=ollama

# Ollama Configuration (only used if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:3b

# OpenRouter Configuration (only used if AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
